{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thocci",
  "version": "1.1.1",
  "identifier": "dev.itzevhyx.thocci",
  "build": {
    "beforeDevCommand": "npm run build:ui",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Thocci",
        "url": "index.html",
        "width": 1160,
        "height": 806,
        "minWidth": 480,
        "minHeight": 440,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Mechanical keyboard sounds for your desktop",
    "longDescription": "Thocci gives your physical keyboard a custom mechanical sound with 41 built-in soundpacks, local WAV import, and an interactive desktop dashboard.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMzVGRUNENUI0NjdEMDYKUldRR2ZVWmJ6ZjQxMDhUbHAxTU1ncDhhTHZaUGRHK1BPVGcyT1F2cDFUbUM4Vi9NT0VTWVF2dHUK",
      "endpoints": [
        "https://github.com/ItzEvhyx/Thocci/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
